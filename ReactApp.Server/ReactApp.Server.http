@ReactApp.Server_HostAddress = http://localhost:5021

GET {{ReactApp.Server_HostAddress}}/health

###

GET {{ReactApp.Server_HostAddress}}/api/meters
Accept: application/json

###

POST {{ReactApp.Server_HostAddress}}/api/meters
Content-Type: application/json

{
  "serialNumber": "TL-000001",
  "name": "Licznik główny",
  "manufacturer": "Apator",
  "model": "Otus 3",
  "firmwareVersion": "1.0.0",
  "tariff": "C11",
  "samplingIntervalSeconds": 900,
  "location": {
    "city": "Warszawa",
    "site": "Biuro główne",
    "lat": 52.2297,
    "lng": 21.0122
  }
}

