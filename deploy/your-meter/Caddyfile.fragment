licznik-api.jfilipek.com {
	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	log {
		output stdout
		format json
	}

	reverse_proxy your-meter-api:8080 {
		health_uri /health
		health_interval 30s
		health_timeout 5s
	}
}
