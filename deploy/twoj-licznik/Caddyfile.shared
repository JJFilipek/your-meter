{
	email {$ACME_EMAIL}
	admin off
	servers {
		protocols h1 h2 h3
	}
}

{$API_DOMAIN:api.jfilipek.com} {
	encode zstd gzip

	request_body {
		max_size 6MB
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	log {
		output stdout
		format json
	}

	reverse_proxy api:8080 {
		health_uri /health/ready
		health_interval 30s
		health_timeout 5s
	}
}

licznik-api.jfilipek.com {
	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	log {
		output stdout
		format json
	}

	reverse_proxy twoj-licznik-api:8080 {
		health_uri /health
		health_interval 30s
		health_timeout 5s
	}
}
